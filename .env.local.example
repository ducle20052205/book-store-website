NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Đợt 3B (checkout). Tất cả CHỈ dùng phía server — không bao giờ thêm tiền tố NEXT_PUBLIC_.
# Email xác nhận đơn gửi qua HTTP API của Brevo. Thiếu một trong hai biến thì bỏ qua im lặng.
BREVO_API_KEY=
BREVO_SENDER=
# Origin tuyệt đối của site dùng cho link trong email, không có dấu / cuối (vd. https://ten-mien-cua-ban).
# Cần ở production (và Preview). Ở máy dev để trống: tự dùng http://localhost:3000. Production thiếu
# biến này thì email vẫn gửi nhưng không có link; xem lib/siteOrigin.ts.
SITE_URL=
# Báo cửa hàng khi có đơn mới (Make.com). Để trống thì không gọi gì cả.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_TOKEN=
# BREVO_API_URL chỉ dùng khi thử với endpoint giả (scripts/mock-external.mjs); không đặt ở production.

# Đợt seed dữ liệu demo (scripts/seed-demo.mjs). Chỉ script đó đọc; CHỈ phía server — không bao giờ thêm tiền tố NEXT_PUBLIC_.
# Khoá service_role lấy ở Supabase Dashboard, đặt vào phiên terminal; không dán vào chat hay repo.
SUPABASE_SERVICE_ROLE_KEY=
# Mật khẩu chung của 25 tài khoản demo; không có giá trị mặc định trong mã.
SEED_DEMO_PASSWORD=
