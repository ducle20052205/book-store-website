NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Đợt 3B (checkout). Tất cả CHỈ dùng phía server — không bao giờ thêm tiền tố NEXT_PUBLIC_.
# Email xác nhận đơn gửi qua HTTP API của Brevo. Thiếu một trong hai biến thì bỏ qua im lặng.
BREVO_API_KEY=
BREVO_SENDER=
# Origin tuyệt đối dùng cho link trong email (vd. https://ten-mien-cua-ban). Để trống thì dùng
# VERCEL_PROJECT_PRODUCTION_URL do Vercel đặt sẵn; xem lib/siteOrigin.ts.
SITE_URL=
# Báo cửa hàng khi có đơn mới (Make.com). Để trống thì không gọi gì cả.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_TOKEN=
# BREVO_API_URL chỉ dùng khi thử với endpoint giả (scripts/mock-external.mjs); không đặt ở production.
